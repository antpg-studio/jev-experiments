{
  "name": "modstream",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run server\" \"vite --host 0.0.0.0\"",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src server shared",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "oxlint": "1.19.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
