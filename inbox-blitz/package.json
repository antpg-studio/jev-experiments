{
  "name": "inbox-blitz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c cyan,magenta \"npm:server\" \"vite --host 0.0.0.0\"",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "start": "npm run build && concurrently -k -n server,vite -c cyan,magenta \"npm:server\" \"vite preview --host 0.0.0.0\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src server",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "10.0.5",
    "oxlint": "1.19.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
