{
  "name": "nl-palette",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,magenta \"npm run server\" \"vite --host 0.0.0.0\"",
    "server": "node --experimental-strip-types --no-warnings server/index.ts",
    "bench": "node --experimental-strip-types --no-warnings server/bench.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint --deny-warnings src server",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "10.0.5",
    "oxlint": "1.19.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
