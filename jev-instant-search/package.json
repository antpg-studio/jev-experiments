{
  "name": "jev-instant-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src server.mjs server",
    "test": "vitest run",
    "bench": "node bench/latency.ts",
    "eval": "node bench/eval.ts"
  },
  "dependencies": {
    "minisearch": "7.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "oxlint": "1.19.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
